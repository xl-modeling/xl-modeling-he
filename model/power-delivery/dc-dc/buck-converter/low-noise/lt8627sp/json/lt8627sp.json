  },
  "noise_model": {
    "type": "string",
    "value": "averaged fixed-duty L/C power-stage transfer of original white and f^-exponent series voltage source",
    "editable": false,
    "band_rule": "0 < f < FSW/10; queries require NOISE_CHAR_MODE=1",
    "transient_noise": "zero, matching ordinary VA transient; no stochastic waveform is injected",
    "limitations": "Not Spectre PSS/Pnoise or closed-loop reference/control noise; no EMI or deterministic ripple included"
  },
  "power_model": {
    "type": "string",
    "value": "bridge conduction + smooth body diode + SW leakage + SVIN*IQ",
    "editable": false,
    "unit": "W",
    "description": "ipvin and isvin are separate supply currents; DCR/ESR loss is external_loss. No calibrated switching/gate-drive/INTVCC-load/SET-source/PG-pullup power or temperature effects."
  },
